# Any OpenAI-compatible endpoint works (Gemini, a LiteLLM proxy, Azure via a proxy, ...).
# Copy this file to .env and fill in your own values. Never commit .env.

# Example: Groq (free tier), OpenAI-compatible endpoint. Replace the whole <...> placeholder with your key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<your-api-key>
# Model names change over time - check the provider's model list if you get "model not found".
# (openai/gpt-oss-120b on Groq does not return proper tool calls in our loop - use Qwen.)
LLM_MODEL=qwen/qwen3.8-27b

# Alternative: Google AI Studio (Gemini)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash

# Optional (defaults shown)
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# MCP_PORT=8000
