# Any OpenAI-compatible endpoint works (Gemini, a LiteLLM proxy, Azure via a proxy, ...).
# Copy this file to .env and fill in your own values. Never commit .env.

# Example: Google AI Studio (Gemini), OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=<your-api-key>
# Model names change over time - check the provider's model list if you get "model not found".
LLM_MODEL=gemini-3.8-flash

# Optional (defaults shown)
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# MCP_PORT=8000
